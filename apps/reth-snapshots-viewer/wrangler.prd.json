{
	"$schema": "https://esm.sh/wrangler/config-schema.json",
	"name": "reth-snapshots-viewer",
	"main": "./src/index.ts",
	"account_id": "ba6ee3674b03f08481e57ff9992c601e",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"r2_buckets": [
		{
			"binding": "SNAPSHOTS",
			"bucket_name": "reth-snapshots",
			"jurisdiction": "eu"
		}
	],
	"vars": {
		"R2_PUBLIC_URL": "https://snapshots-r2.reth.rs"
	},
	"routes": [
		{
			"pattern": "snapshots.reth.rs",
			"custom_domain": true
		}
	],
	"env": {
		"preview": {
			"name": "reth-snapshots-viewer",
			"routes": [],
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"r2_buckets": [
				{
					"binding": "SNAPSHOTS",
					"bucket_name": "reth-snapshots",
					"jurisdiction": "eu"
				}
			],
			"vars": {
				"R2_PUBLIC_URL": "https://snapshots-r2.reth.rs"
			}
		}
	}
}
