{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "og",
	"main": "src/index.tsx",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		"EXPLORER_URL": "https://explorer.tempo.xyz"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/bg-default.webp",
			"/og-blocks.webp",
			"/bg-list-blocks.webp",
			"/og-tokens.webp",
			"/bg-list-tokens.webp",
			"/og-transactions.webp"
		]
	},
	"ratelimits": [
		{
			"name": "REQUESTS_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 30,
				"period": 10
			}
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
