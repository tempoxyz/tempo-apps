# Ed25519 private JWK as a JSON string (with d and x). Generate with `pnpm keygen`.
# Configure in production with `wrangler secret put ATTESTATION_PRIVATE_KEY`.
ATTESTATION_PRIVATE_KEY=

# LOCAL DEVELOPMENT ONLY: "true" logs one-time codes to the console.
# Never set this in production (not as a var, not as a secret).
DEV_LOG_OTP=
