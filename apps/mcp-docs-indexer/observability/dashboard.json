{
	"title": "Tempo Docs MCP \u2014 Service Overview",
	"description": "Operational view of mcp.tempo.xyz. Availability, indexed retrieval, and ingestion are separate signals. Traffic includes health probes. Source census rotates hourly. Missing data is not zero. Source: tempoxyz/tempo-apps/apps/mcp-docs-indexer.",
	"layout_type": "ordered",
	"widgets": [
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_health_ok{service:tempo-docs-mcp}"
					}
				],
				"show_legend": true,
				"title": "Public availability (1 = healthy)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_health_check_ok{service:tempo-docs-mcp,check:search_tempo_indexed}"
					}
				],
				"show_legend": true,
				"title": "Indexed retrieval (1 = AI Search)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_ingest_ok{service:tempo-docs-mcp}"
					}
				],
				"show_legend": true,
				"title": "Hourly ingestion (1 = no failures)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_health_check_ok{service:tempo-docs-mcp} by {check}"
					}
				],
				"show_legend": true,
				"title": "Health by check",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_http_request_count{service:tempo-docs-mcp} by {route,status_class}.as_count()"
					}
				],
				"show_legend": true,
				"title": "Requests, including health probes",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_tool_call_count{service:tempo-docs-mcp} by {tool_name,outcome}.as_count()"
					}
				],
				"show_legend": true,
				"title": "Tool outcomes",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_tool_duration_ms{service:tempo-docs-mcp} by {tool_name}"
					}
				],
				"show_legend": true,
				"title": "Tool latency (ms)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_http_error_count{service:tempo-docs-mcp} by {route}.as_count()"
					}
				],
				"show_legend": true,
				"title": "HTTP server errors",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_jsonrpc_error_count{service:tempo-docs-mcp} by {error_code,mcp_method}.as_count()"
					}
				],
				"show_legend": true,
				"title": "JSON-RPC errors",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_ai_search_request_count{service:tempo-docs-mcp} by {path}.as_count()"
					}
				],
				"show_legend": true,
				"title": "AI Search completed requests",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_ai_search_empty_result_count{service:tempo-docs-mcp} by {path}.as_count()"
					}
				],
				"show_legend": true,
				"title": "AI Search empty results",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_proxy_fallback_count{service:tempo-docs-mcp} by {status_class}.as_count()"
					}
				],
				"show_legend": true,
				"title": "Proxy fallback",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_source_items_pending{service:tempo-docs-mcp} by {source}"
					}
				],
				"show_legend": true,
				"title": "Pending index items",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_source_pages_failed{service:tempo-docs-mcp} by {source}.as_count()"
					}
				],
				"show_legend": true,
				"title": "Page failures (retries may repeat)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_source_sync_count{service:tempo-docs-mcp} by {source,status}.as_count()"
					}
				],
				"show_legend": true,
				"title": "Source sync outcomes",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"requests": [
					{
						"display_type": "line",
						"q": "avg:tempo_docs_mcp_source_items{service:tempo-docs-mcp} by {source,status}"
					}
				],
				"show_legend": true,
				"title": "Source census (rotates hourly; sparse)",
				"type": "timeseries"
			}
		},
		{
			"definition": {
				"type": "timeseries",
				"title": "Retrieval mode including cache hits",
				"show_legend": true,
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_retrieval_count{service:tempo-docs-mcp} by {mode,traffic}.as_count()"
					}
				]
			}
		},
		{
			"definition": {
				"type": "timeseries",
				"title": "AI Search dependency failures",
				"show_legend": true,
				"requests": [
					{
						"display_type": "line",
						"q": "sum:tempo_docs_mcp_ai_search_error_count{service:tempo-docs-mcp} by {path}.as_count()"
					}
				]
			}
		},
		{
			"definition": {
				"type": "timeseries",
				"title": "Time since confirmed ready sync (seconds)",
				"show_legend": true,
				"requests": [
					{
						"display_type": "line",
						"q": "max:tempo_docs_mcp_source_ready_age_seconds{service:tempo-docs-mcp} by {source}"
					}
				]
			}
		},
		{
			"definition": {
				"type": "timeseries",
				"title": "Continuous indexing backlog age (seconds)",
				"show_legend": true,
				"requests": [
					{
						"display_type": "line",
						"q": "max:tempo_docs_mcp_source_pending_age_seconds{service:tempo-docs-mcp} by {source}"
					}
				]
			}
		}
	]
}
