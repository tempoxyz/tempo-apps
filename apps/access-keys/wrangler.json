{
	"$schema": "https://esm.sh/wrangler/config-schema.json",
	"name": "managed-access-keys",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"observability": { "enabled": true },
	"durable_objects": {
		"bindings": [{ "name": "KEYS", "class_name": "KeyStore" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["KeyStore"] }]
}
