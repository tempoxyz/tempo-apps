{
	"$schema": "https://esm.sh/wrangler/config-schema.json",
	"name": "fee-payer",
	"account_id": "ba6ee3674b03f08481e57ff9992c601e",
	"compatibility_date": "2025-12-17",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/index.ts",
	"workers_dev": false,
	"ratelimits": [
		{
			"name": "ADDRESS_RATE_LIMITER",
			"namespace_id": "888",
			"simple": {
				"limit": 1000,
				"period": 60
			}
		}
	],
	"preview_urls": false,
	"logpush": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true,
			"destinations": ["internal-logs"]
		},
		"traces": {
			"enabled": true,
			"destinations": ["internal-traces"]
		}
	},
	"env": {
		"moderato": {
			"name": "fee-payer-moderato",
			"routes": [
				{
					"pattern": "sponsor.testnet.tempo.xyz",
					"custom_domain": true
				},
				{
					"pattern": "sponsor.moderato.tempo.xyz",
					"custom_domain": true
				}
			],
			"workers_dev": false,
			"vars": {
				"ALLOWED_ORIGINS": "*",
				"POSTHOG_API_KEY": "",
				"TEMPO_ENV": "moderato",
				"TEMPO_RPC_URL": "https://rpc.moderato.tempo.xyz"
			},
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"ratelimits": [
				{
					"name": "ADDRESS_RATE_LIMITER",
					"namespace_id": "888",
					"simple": {
						"limit": 1000,
						"period": 60
					}
				}
			]
		},
		"mainnet": {
			"name": "fee-payer-mainnet",
			"placement": {
				"mode": "smart"
			},
			"routes": [
				{
					"pattern": "sponsor.tempo.xyz",
					"custom_domain": true
				}
			],
			"workers_dev": false,
			"vars": {
				"ALLOWED_ORIGINS": "*",
				"TEMPO_ENV": "mainnet"
			},
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"ratelimits": [
				{
					"name": "ADDRESS_RATE_LIMITER",
					"namespace_id": "888",
					"simple": {
						"limit": 30,
						"period": 60
					}
				},
				{
					"name": "KEYED_ADDRESS_RATE_LIMITER",
					"namespace_id": "889",
					"simple": {
						"limit": 5000,
						"period": 60
					}
				}
			]
		}
	}
}
