# Tempo network this deployment serves: mainnet, moderato or devnet.
# Mainnet sponsors only TEMPO_LEGACY_KEYS; other networks sponsor anyone.
TEMPO_ENV=moderato

# Tempo API key (Tempo-owned org) that sponsors every forwarded request.
TEMPO_API_KEY=

# Comma-separated legacy tp_ keys still accepted on mainnet.
TEMPO_LEGACY_KEYS=
