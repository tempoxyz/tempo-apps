diff --git a/src/runner/tool-coverage-head.test.ts b/src/runner/tool-coverage-head.test.ts
new file mode 100644
index 0000000..a0aa3da
--- /dev/null
+++ b/src/runner/tool-coverage-head.test.ts
@@ -0,0 +1,109 @@
+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { structuredToolEvents, ToolCoverageNormalizer, type CoverageHarness } from "./tool-coverage.js";
+
+const roots: string[] = [];
+afterEach(() => { while (roots.length) rmSync(roots.pop()!, { recursive: true, force: true }); });
+
+function fixture() {
+  const root = mkdtempSync(join(tmpdir(), "cyclops-tool-coverage-"));
+  roots.push(root);
+  writeFileSync(join(root, "source.ts"), "one\ntwo\nthree\nfour\n");
+  return root;
+}
+
+function lifecycle(backend: CoverageHarness, id: string, name: string, input: unknown, failed = false,
+  output: unknown = "one\ntwo\nthree\nfour\n"): unknown[] {
+  if (backend === "amp" || backend === "claude") return [
+    { type: "assistant", message: { content: [{ type: "tool_use", id, name, input }] } },
+    { type: "user", message: { content: [{ type: "tool_result", tool_use_id: id, content: output, is_error: failed }] } },
+  ];
+  return [
+    { type: "tool.started", id, name, input },
+    { type: "tool.completed", id, name, output, failed },
+  ];
+}
+
+function consume(normalizer: ToolCoverageNormalizer, values: unknown[]) {
+  return values.flatMap(value => structuredToolEvents(value).map(event => normalizer.consume(event))).filter(Boolean);
+}
+
+describe("numbered head source coverage", () => {
+  for (const backend of ["codex", "claude"] as const) {
+    // scan_mup3kf2k_e0p3ab lost `nl -ba .../CopyButton.tsx | head -65`.
+    test.each(["-65", "-n 65", "-n65", "--lines=65"])(`${backend} credits numbered head %s only through returned source lines`, (bound) => {
+      const cwd = fixture(), observations: unknown[] = [];
+      const coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head",
+        onObservation: value => { observations.push(value); } });
+      const command = `/usr/bin/bash -lc 'nl -ba source.ts | head ${bound}'`;
+      consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+        { command }, false, "     1\tone\n     2\ttwo\n... output truncated ...\n"));
+      expect(observations).toEqual([{ filePath: join(cwd, "source.ts"), startLine: 1, endLine: 2, kind: "read" }]);
+      expect(coverage.snapshot()).toMatchObject({ accepted: 1, losses: 0 });
+    });
+
+    test(`${backend} caps numbered head evidence at the literal bound`, () => {
+      const cwd = fixture(), observations: unknown[] = [];
+      const coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head-bound",
+        onObservation: value => { observations.push(value); } });
+      consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+        { command: 'nl -ba "source.ts" | head -n 2' }, false,
+        "     1\tone\n     2\ttwo\n     3\tthree\n     4\tfour\n"));
+      expect(observations).toEqual([{ filePath: join(cwd, "source.ts"), startLine: 1, endLine: 2, kind: "read" }]);
+    });
+
+    test.each([
+      ["EOF", "     1\tone\n     2\ttwo\n     3\tthree\n     4\tfour\n", 4],
+      ["truncated middle", "     1\tone\n... output truncated ...\n     3\tthree\n     4\tfour\n", 1],
+      ["different source bytes", "     1\tone\n     2\told revision\n     3\tthree\n", 1],
+    ] as const)(`${backend} bounds numbered head at %s`, (_name, output, endLine) => {
+      const cwd = fixture(), observations: unknown[] = [];
+      const coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head-prefix",
+        onObservation: value => { observations.push(value); } });
+      consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+        { command: "nl -ba source.ts | head -65" }, false, output));
+      expect(observations).toEqual([{ filePath: join(cwd, "source.ts"), startLine: 1, endLine, kind: "read" }]);
+    });
+
+    test(`${backend} does not credit numbered head outside the prepared workspace`, () => {
+      const cwd = fixture(), coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head-outside",
+        onObservation: () => { throw new Error("outside source must not become evidence"); } });
+      consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+        { command: "nl -ba ../source.ts | head -65" }, false, "     1\tone\n"));
+      expect(coverage.snapshot()).toMatchObject({ accepted: 0, losses: 1,
+        loss_reasons: { path_outside_workspace: 1 } });
+    });
+
+    test.each(["", "... output truncated ...", "     1\told revision\n", "     2\ttwo\n"])(
+      `${backend} rejects numbered head output without a matching initial source interval: %s`, (output) => {
+        const cwd = fixture(), coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head-output",
+          onObservation: () => { throw new Error("unobserved source must not become evidence"); } });
+        consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+          { command: "nl -ba source.ts | head -65" }, false, output));
+        expect(coverage.snapshot()).toMatchObject({ accepted: 0, losses: 1,
+          loss_reasons: { range_unavailable: 1 } });
+      });
+
+    test.each([
+      "nl -ba source.ts | head -n $LIMIT",
+      "nl -ba source.ts | head -n $(echo 2)",
+      "nl -ba source.ts | head -n -2",
+      "nl -ba source.ts | head -0",
+      "nl -ba source.ts | head -9007199254740992",
+      "nl -ba source.ts | head -c 2",
+      "nl -ba source.ts | head -2 | sort",
+      "nl -ba source.ts | tee copy.ts | head -2",
+      "nl -ba source.ts | head -2 other.ts",
+    ])(`${backend} does not credit unsupported numbered head form %s`, (command) => {
+      const cwd = fixture(), coverage = new ToolCoverageNormalizer({ backend, cwd, invocation: "numbered-head-reject",
+        onObservation: () => { throw new Error("unsupported pipeline must not become evidence"); } });
+      consume(coverage, lifecycle(backend, "head", backend === "codex" ? "command_execution" : "Bash",
+        { command }, false, "     1\tone\n     2\ttwo\n"));
+      expect(coverage.snapshot()).toMatchObject({ accepted: 0, losses: 1,
+        loss_reasons: { unsupported_source_intent: 1 } });
+    });
+
+  }
+});
